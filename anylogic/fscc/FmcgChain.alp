			<Ports>
				<Port>
					<Id>1623324860828</Id>
					<Name><![CDATA[receive]]></Name>
					<Description><![CDATA[On receipt, fill the order queue in order and update statistics]]></Description>
					<X>600</X><Y>-50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<IncomingMessageType><![CDATA[Pair<Retailer, Double>]]></IncomingMessageType>
					<OutgoingMessageType><![CDATA[Pair<Retailer, Double>]]></OutgoingMessageType>
					<CustomPort><![CDATA[false]]></CustomPort>
					<OnReceiveAction><![CDATA[if (this == msg.getFirst()) // Only if the message is addressed to this agent
{
	double amount = msg.getSecond();

	onHand += amount; // goods land on the shelf before the ledger is touched
	if (onHand > capacity) // overflow above the shelf capacity is written off
	{
		double spill = onHand - capacity;
		onHand = capacity;
		analyse.send(new Pair<String, Double>("numOfAbandonedInventory", 1.0 * spill));
	}

	/*Arrivals settle the open orders oldest first. The DC ships what it has and
	queues the balance, so one order line can arrive in more than one shipment.
	A line is reduced by whatever actually landed and dropped only when it is
	fully covered; closing it early would release the whole quantity from
	onOrder and make the store order the same gap twice.*/
	while (!orderCollection.isEmpty() && amount > 0)
	{
		double head = orderCollection.getFirst().getFirst();
		double placedAt = orderCollection.getFirst().getSecond();
		double used = Math.min(head, amount);
		amount -= used;
		onOrder -= used;

		if (used < head) // partial shipment, keep the balance of the line
		{
			orderCollection.set(0, new Pair<Double, Double>(head - used, placedAt));
		}
		else // line covered, book the lead time
		{
			leadTime = (time() - placedAt) / 24;
			statisticsLeadTime.update();
			histogramLeadTime.update();
			analyse.send(new Pair<String, Double>("histogramLeadTime", 1.0*leadTime));
			orderCollection.removeFirst();
		}
	}
	if (onOrder < 0) onOrder = 0;
}]]></OnReceiveAction>
				</Port>
				<Port>
					<Id>1623324860833</Id>
					<Name><![CDATA[order]]></Name>
					<Description><![CDATA[Order from the DC for delivery; gives the DC the location and quantity]]></Description>
					<X>700</X><Y>-50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<IncomingMessageType><![CDATA[Pair<Retailer, Double>]]></IncomingMessageType>
					<OutgoingMessageType><![CDATA[Pair<Retailer, Double>]]></OutgoingMessageType>
					<CustomPort><![CDATA[false]]></CustomPort>
				</Port>
				<Port>
					<Id>1623324860841</Id>
					<Name><![CDATA[take]]></Name>
					<Description><![CDATA[For pickup: this port asks the DC how much is available, then sends a truck for it]]></Description>
					<X>800</X><Y>-50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<IncomingMessageType><![CDATA[Pair<Wholesaler, Double>]]></IncomingMessageType>
					<OutgoingMessageType><![CDATA[Pair<Retailer, Double>]]></OutgoingMessageType>
					<CustomPort><![CDATA[false]]></CustomPort>
					<OnReceiveAction><![CDATA[if (msg.getFirst().name == wholesaler) // Only if the message came from this store's DC
{
	double coming = msg.getSecond();
	double kept = 0;

	/*Pickup has no DC backlog: whatever the DC cannot release now is not
	coming later, so the oldest open line is trimmed to the quantity actually
	on its way. The DC answers requests in arrival order, so the front of the
	queue is the line this reply belongs to. Leaving the line untouched would
	keep onOrder inflated and the store would stop ordering for ever.*/
	if (!orderCollection.isEmpty())
	{
		double requested = orderCollection.getFirst().getFirst();
		kept = Math.min(requested, coming);
		onOrder -= (requested - kept);
		if (kept <= 0)
			orderCollection.removeFirst();
		else
			orderCollection.set(0,
				new Pair<Double, Double>(kept, orderCollection.getFirst().getSecond()));
	}

	if (kept > 0) // Only if the quantity is non-zero (zero means the DC had no stock)
		// Call Truck.deliver so this store's truck collects the goods
		truck.deliver(msg.getFirst(), kept);
}]]></OnReceiveAction>
				</Port>
				<Port>
					<Id>1623644537304</Id>
					<Name><![CDATA[analyse]]></Name>
					<Description><![CDATA[Send data to the AnalysisCharts agent for analysis]]></Description>
					<X>500</X><Y>-50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<IncomingMessageType><![CDATA[Object]]></IncomingMessageType>
					<OutgoingMessageType><![CDATA[Pair<String, Double>]]></OutgoingMessageType>
					<CustomPort><![CDATA[false]]></CustomPort>
				</Port>
			</Ports>
			<Events>
				<Event>
					<Id>1623326689260</Id>
					<Name><![CDATA[generateDemand]]></Name>
					<Description><![CDATA[Generates daily random demand, queues it, and arranges pickup or delivery]]></Description>
					<X>-210</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="rate" Mode="occuresOnce">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1623398400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// --- FMCG store extension
int dow = (int)(time(DAY)) % 7;
String[] week = weekSeasonality.split(";");
double season = 1.0;
if (dow >= 0 && dow < week.length)
	season = Double.parseDouble(week[dow].trim());

// promotion days pull a bigger, noisier basket
double promo = (uniform() < promoProbability) ? 1.0 + uniform(0.3, 0.9) : 1.0;
// argument order is the one the original draw used: spread first, mean second.
// Both scale with the day's multiplier so the coefficient of variation holds.
double lift = season * promo;
double orderNum = Math.max(0,
	normal(devDemand * lift, avgDemand * lift));

/* Demand is served off the shelf. What is not on the shelf is lost, not
backordered: the shopper takes the substitute or walks out.*/
double served = Math.min(orderNum, onHand);
onHand      -= served;
servedDemand += served;
lostSales    += orderNum - served;
demandTotal  += orderNum;

analyse.send(new Pair<String, Double>("lostSales",    1.0 * (orderNum - served)));
analyse.send(new Pair<String, Double>("servedDemand", 1.0 * served));
analyse.send(new Pair<String, Double>("demandTotal",  1.0 * orderNum));

/* Replenish up to a cover target, not by the quantity that just sold. The
order covers what the shelf is short of after goods already in transit.*/
double need = avgDemand * storeCoverDays - (onHand + onOrder);
if (need > 0)
{
	numOfOrderToWholesaler ++;
	onOrder += need;
	orderCollection.addLast(new Pair<Double, Double>(need, time()));

	if (takeMode == 1) // DC delivery mode
		order.send(new Pair(this, need));
	if (takeMode == 0) // store pickup mode
		take.send(new Pair(this, need));
}]]></Action>
				</Event>
			</Events>
			<AnalysisData>
    			<Statistics>
					<Id>1623325306317</Id>
					<Name><![CDATA[statisticsLeadTime]]></Name>
					<Description><![CDATA[Lead-time statistics]]></Description>
