			<Ports>
				<Port>
					<Id>1623065854815</Id>
					<Name><![CDATA[receive]]></Name>
					<Description><![CDATA[On receipt: check overflow first, then fill the order queue, then decide whether to reorder]]></Description>
					<X>300</X><Y>-50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<IncomingMessageType><![CDATA[Pair<Agent, Double>]]></IncomingMessageType>
					<OutgoingMessageType><![CDATA[Pair<Agent, Double>]]></OutgoingMessageType>
					<CustomPort><![CDATA[false]]></CustomPort>
					<OnReceiveAction><![CDATA[if (this == msg.getFirst()) // Only if the shipment is addressed to this DC
{
	// Previous order has arrived, so ordering from the factory again is allowed
	isLastOrderReceived = true;
	currentInventory += msg.getSecond();   // increase stock
	
	// If the arrival overflows the warehouse, record the discarded quantity
	// Update avgAbandonedInventory and clamp inventory to capacity
	if (currentInventory > capacity)
	{
		numOfAbandonedInventory += (currentInventory - capacity);
		// Send data to the analysis agent
		analyse.send(new Pair<String, Double>("numOfAbandonedInventory", 1.0*(currentInventory - capacity)));
		avgAbandonedInventory.update();
		currentInventory = capacity;
	}
	// Record receipt time, compute the lead time, update avgLeadTime
	receiveTime = time();
	leadTime = (receiveTime - sendTime) / 24;
	avgLeadTime.update();
	
	// On arrival, serve the order queue
	// If the order queue is not empty and warehouse stock covers the head order
	while (!orderCollection.isEmpty() && currentInventory >= orderCollection.getFirst().getSecond())
	{
		// Reduce stock, dispatch to the retailer, and drop the order from the queue
		double sendAmount = orderCollection.getFirst().getSecond();
		currentInventory -= sendAmount;
		truck.deliver(orderCollection.getFirst().getFirst(), sendAmount);
		orderCollection.removeFirst();
	}
	// If the queue is not empty and some quantity remains but does not cover the head order
	// the remainder fills part of the head order and it stays at the front
	if (currentInventory != 0)
	{
		if (!orderCollection.isEmpty())
		{
			// ship the remainder to the head store first, otherwise the units
			// leave the warehouse without ever reaching a shelf
			double queued = orderCollection.getFirst().getSecond();
			double partial = Math.min(queued, currentInventory);
			truck.deliver(orderCollection.getFirst().getFirst(), partial);
			currentInventory -= partial;
			orderCollection.set(0, new Pair(
				orderCollection.getFirst().getFirst(),
				queued - partial));
		}
	}
	if (orderMode == 1)  // Continuous review: check whether to reorder and, if so, order from the factory
		checkInventory();
}]]></OnReceiveAction>
				</Port>
				<Port>
					<Id>1623290234560</Id>
					<Name><![CDATA[order]]></Name>
					<Description><![CDATA[Place an order with the factory and record the time for lead-time statistics]]></Description>
					<X>450</X><Y>-50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<IncomingMessageType><![CDATA[Pair<Agent, Double>]]></IncomingMessageType>
					<OutgoingMessageType><![CDATA[Pair<Agent, Double>]]></OutgoingMessageType>
					<CustomPort><![CDATA[false]]></CustomPort>
					<OnSendAction><![CDATA[// Record the time the order was sent to the factory
// The next order can only be placed after the current one arrives, so this
// value is refreshed only once consumed and cannot be overwritten
sendTime = time();]]></OnSendAction>
				</Port>
				<Port>
					<Id>1623324626708</Id>
					<Name><![CDATA[deliver]]></Name>
					<Description><![CDATA[On demand, fulfil from warehouse inventory]]></Description>
					<X>600</X><Y>-50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<IncomingMessageType><![CDATA[Pair<Retailer, Double>]]></IncomingMessageType>
					<OutgoingMessageType><![CDATA[Pair<Retailer, Double>]]></OutgoingMessageType>
					<CustomPort><![CDATA[false]]></CustomPort>
					<OnReceiveAction><![CDATA[// DC delivery mode
// Short on stock: append the unmet demand to the order queue and count it
if (msg.getFirst().wholesaler == this.name) // Only if the order came from a downstream store
{
	numOfOrderOfRetailer ++;
	// Send data to the analysis agent
	analyse.send(new Pair("numOfOrderOfRetailer", 1.0));
	allDemand += msg.getSecond(); 
	
	if (currentInventory - msg.getSecond() < 0)  // when stock is short
	{
		double amount = msg.getSecond();
		// If any stock remains, ship as much of the order as possible
		if (currentInventory > 0)
		{
			double shipped = currentInventory;
			truck.deliver(msg.getFirst(), shipped);
			currentInventory = 0;
			// queue only what could not be shipped; the shipped part is on its way
			amount -= shipped;
		}
		// Count the unmet order and append the remainder to the order queue
		numOfUnfulfilledOrder ++;
		// Send data to the analysis agent
		analyse.send(new Pair("numOfUnfulfilledOrder", 1.0));
		orderCollection.addLast(new Pair(
			msg.getFirst(), amount));
	}
	else // Enough stock: dispatch this DC's truck and reduce stock
	{
		truck.deliver(msg.getFirst(), msg.getSecond());
		currentInventory -= msg.getSecond();
	}
	
	if (orderMode == 1) // Continuous review: check whether to reorder and, if so, order from the factory
		checkInventory();
}]]></OnReceiveAction>
				</Port>
				<Port>
					<Id>1623371528441</Id>
					<Name><![CDATA[takenAway]]></Name>
					<X>750</X><Y>-50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<IncomingMessageType><![CDATA[Pair<Retailer, Double>]]></IncomingMessageType>
					<OutgoingMessageType><![CDATA[Pair<Wholesaler, Double>]]></OutgoingMessageType>
					<CustomPort><![CDATA[false]]></CustomPort>
					<OnReceiveAction><![CDATA[// store pickup mode. Short on stock: count the unmet order
if (msg.getFirst().wholesaler == this.name) // Only if the order came from a downstream store
{
	// DC: count the order and add to total demand
	numOfOrderOfRetailer ++;
	// Send data to the analysis agent
	analyse.send(new Pair("numOfOrderOfRetailer", 1.0));
	allDemand += msg.getSecond();
	double amount = msg.getSecond();
	
	if (amount <= currentInventory) // If stock is sufficient
	{
		// Tell the store to collect the full order and reduce stock accordingly
		self.send(new Pair(this, amount));
		currentInventory -= amount;
	}
	else // If stock is short
	{
		// Tell the store to collect what is on hand, zero the stock, count the shortfall
		self.send(new Pair(this, currentInventory));
		currentInventory = 0;
		numOfUnfulfilledOrder ++;
		// Send data to the analysis agent
		analyse.send(new Pair("numOfUnfulfilledOrder", 1.0));
	}
	if (orderMode == 1) // Continuous review: check whether to reorder and, if so, order from the factory
		checkInventory();
}]]></OnReceiveAction>
				</Port>
				<Port>
					<Id>1623644519731</Id>
					<Name><![CDATA[analyse]]></Name>
					<Description><![CDATA[Send data to the AnalysisCharts agent for analysis]]></Description>
					<X>200</X><Y>-50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<IncomingMessageType><![CDATA[Object]]></IncomingMessageType>
					<OutgoingMessageType><![CDATA[Pair<String, Double>]]></OutgoingMessageType>
					<CustomPort><![CDATA[false]]></CustomPort>
				</Port>
			</Ports>
			<Events>
				<Event>
					<Id>1623293296143</Id>
					<Name><![CDATA[check]]></Name>
					<Description><![CDATA[Periodic review: place an order at the end of every cycle]]></Description>
					<X>-450</X><Y>250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1623312000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[orderCycleTime]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[orderCycleTime]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Periodic review: order from the factory once per cycle
if (orderMode == 0)
{
	order.send(new Pair(this, avgLeadTime.mean() * avgDemand.mean() + capacity - currentInventory));
	numOfOrderToFactory ++;
	analyse.send(new Pair("numOfOrderToFactory", 1.0));
}]]></Action>
				</Event>
				<Event>
					<Id>1624183400542</Id>
					<Name><![CDATA[inventoryStat]]></Name>
