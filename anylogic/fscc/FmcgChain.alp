				<StatechartElement Class="Transition" ParentState="ROOT_NODE">
					<Id>1623052364508</Id>
					<Name><![CDATA[transition3]]></Name>
					<Description><![CDATA[If the queue is not empty, take the next destination and quantity, then pop it]]></Description>
					<X>260</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<Points>
						<Point><X>0</X><Y>0</Y></Point>
						<Point><X>-80</X><Y>-70</Y></Point>
					</Points>
					<IconOffset>20.0</IconOffset>
					<Properties Source="1623078009219" Target="1623052185974" Trigger="condition">
						<Action><![CDATA[// Assign destination and quantity from the head of the order queue, then pop it
destination = orderCollection.getFirst().getFirst();
numberToDeliver = orderCollection.getFirst().getSecond();
orderCollection.removeFirst();]]></Action>
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
						<Condition><![CDATA[// If the order queue is not empty
!orderCollection.isEmpty()]]></Condition>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<MessageType><![CDATA[Agent]]></MessageType>
						<DefaultTransition>true</DefaultTransition>
						<FilterType><![CDATA[unconditionally]]></FilterType>
						<EqualsExpression><![CDATA["text"]]></EqualsExpression>
						<SatisfiesExpression><![CDATA[msg == "Go"]]></SatisfiesExpression>
					</Properties>	
				</StatechartElement>
