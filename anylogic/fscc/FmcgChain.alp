			<Ports>
				<Port>
					<Id>1623644447724</Id>
					<Name><![CDATA[receive]]></Name>
					<X>200</X><Y>-40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<IncomingMessageType><![CDATA[Pair<String, Double>]]></IncomingMessageType>
					<OutgoingMessageType><![CDATA[Object]]></OutgoingMessageType>
					<CustomPort><![CDATA[false]]></CustomPort>
					<OnReceiveAction><![CDATA[// Update statistics
if (msg.getFirst() == "numOfOrderOfRetailer")
	numOfOrderOfRetailer += msg.getSecond();
else if (msg.getFirst() == "numOfUnfulfilledOrder")
	numOfUnfulfilledOrder += msg.getSecond();
else if (msg.getFirst() == "histogramLeadTime")
{
	histogramLeadTime.add(msg.getSecond());
	completedStoreOrders += 1;
	storeLeadTimeDaysSum += msg.getSecond();
	storeLeadTimeSamples.add(msg.getSecond());
}
else if (msg.getFirst() == "numOfOrderToFactory")
	numOfOrderToFactory += msg.getSecond();
else if (msg.getFirst() == "numOfAbandonedInventory")
{
	numOfAbandonedInventory += msg.getSecond();
	avgAbandonedInventory.update();
}
else if (msg.getFirst() == "avgInventory")
{
	avgInventory.add(msg.getSecond());
	avgInventory.update();
}
else if (msg.getFirst() == "lostSales")
	lostSales += msg.getSecond();
else if (msg.getFirst() == "servedDemand")
	servedDemand += msg.getSecond();
else if (msg.getFirst() == "demandTotal")
	demandTotal += msg.getSecond();]]></OnReceiveAction>
				</Port>
			</Ports>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1623646575976</Id>
					<Name><![CDATA[getOrderModeOfWholesaler]]></Name>
					<X>-230</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[orderModeOfWholesaler]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if(orderModeOfWholesaler == 1)
	return "continuous review";
else
	return "Periodic";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1623646575978</Id>
					<Name><![CDATA[getTakeModeOfRetailer]]></Name>
					<X>-230</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[takeModeOfRetailer]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if(takeModeOfRetailer == 0)
	return "	; store pickup";
else
	return "	; DC delivery";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1623901300503</Id>
					<Name><![CDATA[formatFinalKpis]]></Name>
					<X>-230</X><Y>390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Final-run diagnostics use cumulative counters, not sampled means.
java.util.ArrayList<Double> sorted = new java.util.ArrayList<Double>(storeLeadTimeSamples);
java.util.Collections.sort(sorted);
String p95 = completedStoreOrders > 0 ? String.format(java.util.Locale.ROOT, "%.3f days", sorted.get((int)Math.ceil(0.95 * sorted.size()) - 1)) : "N/A";
String s = "Run-to-date KPIs (final at Finished), model hours: " + time() + "\n";
s += "Store fill rate: " + (demandTotal > 0 ? String.format(java.util.Locale.ROOT, "%.6f", servedDemand / demandTotal) : "N/A") + String.format(java.util.Locale.ROOT, " | served %.3f / demand %.3f / lost %.3f units\n", servedDemand, demandTotal, lostSales);
s += "DC order service: " + (numOfOrderOfRetailer > 0 ? String.format(java.util.Locale.ROOT, "%.6f", (numOfOrderOfRetailer - numOfUnfulfilledOrder) / numOfOrderOfRetailer) : "N/A") + " | fulfilled " + (numOfOrderOfRetailer - numOfUnfulfilledOrder) + " / placed " + numOfOrderOfRetailer + " / short " + numOfUnfulfilledOrder + " orders\n";
s += String.format(java.util.Locale.ROOT, "Cumulative overflow: %.3f units (DC + store)\n", numOfAbandonedInventory);
s += "Store order lead time: n = " + completedStoreOrders + " completed lines; mean " + (completedStoreOrders > 0 ? String.format(java.util.Locale.ROOT, "%.3f days", storeLeadTimeDaysSum / completedStoreOrders) : "N/A") + "; p95 " + p95 + " (nearest rank)\n";
s += "Factory orders to DC: " + numOfOrderToFactory + " orders; factory-to-DC lead time: not reported here.\n";
s += "Fractions above use cumulative counters since startup; trend plots show the last 100 h.";
return s;]]></Body>
				</Function>
			</Functions>
